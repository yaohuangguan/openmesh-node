{
  "name": "openmesh-node",
  "version": "0.5.0",
  "description": "TypeScript-first Node.js service runtime for native HTTP APIs and application-native microservices with discovery, traffic policy, resilience, mTLS and observability.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaohuangguan/openmesh-node.git"
  },
  "homepage": "https://openmesh-node.vercel.app/",
  "bugs": {
    "url": "https://github.com/yaohuangguan/openmesh-node/issues"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/types/plugins/index.d.mts",
        "default": "./dist/esm/plugins/index.js"
      },
      "require": {
        "types": "./dist/types/plugins/index.d.ts",
        "default": "./dist/cjs/plugins/index.js"
      }
    },
    "./http": {
      "import": {
        "types": "./dist/types/http/index.d.mts",
        "default": "./dist/esm/http/index.js"
      },
      "require": {
        "types": "./dist/types/http/index.d.ts",
        "default": "./dist/cjs/http/index.js"
      }
    },
    "./db": {
      "import": {
        "types": "./dist/types/db/index.d.mts",
        "default": "./dist/esm/db/index.js"
      },
      "require": {
        "types": "./dist/types/db/index.d.ts",
        "default": "./dist/cjs/db/index.js"
      }
    },
    "./mesh": {
      "import": {
        "types": "./dist/types/mesh/index.d.mts",
        "default": "./dist/esm/mesh/index.js"
      },
      "require": {
        "types": "./dist/types/mesh/index.d.ts",
        "default": "./dist/cjs/mesh/index.js"
      }
    },
    "./services": {
      "import": {
        "types": "./dist/types/services/index.d.mts",
        "default": "./dist/esm/services/index.js"
      },
      "require": {
        "types": "./dist/types/services/index.d.ts",
        "default": "./dist/cjs/services/index.js"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/types/otel/index.d.mts",
        "default": "./dist/esm/otel/index.js"
      },
      "require": {
        "types": "./dist/types/otel/index.d.ts",
        "default": "./dist/cjs/otel/index.js"
      }
    },
    "./services/testing": {
      "import": {
        "types": "./dist/types/services/testing/index.d.mts",
        "default": "./dist/esm/services/testing/index.js"
      },
      "require": {
        "types": "./dist/types/services/testing/index.d.ts",
        "default": "./dist/cjs/services/testing/index.js"
      }
    },
    "./services/redis": {
      "import": {
        "types": "./dist/types/services/redis/index.d.mts",
        "default": "./dist/esm/services/redis/index.js"
      },
      "require": {
        "types": "./dist/types/services/redis/index.d.ts",
        "default": "./dist/cjs/services/redis/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.en.md",
    "docs",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "examples"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node examples/basic.mjs",
    "demo:cluster": "node examples/cluster.mjs --demo",
    "demo:services": "node examples/services.mjs --demo",
    "example:services": "node examples/services.mjs",
    "example:control": "node examples/control-plane.mjs",
    "example:cluster": "node examples/cluster.mjs",
    "example:ecosystem": "node examples/ecosystem.mjs",
    "test": "npm run check && npm run build && node --test tests/*.test.cjs",
    "test:types": "npm run build && tsc --ignoreConfig --noEmit --strict --types node --module NodeNext --moduleResolution NodeNext --target ES2022 tests/types.mts tests/types.cts",
    "test:package": "npm run build && node scripts/package-smoke.cjs",
    "bench": "node benchmarks/run.cjs",
    "bench:smoke": "node benchmarks/run.cjs --duration=1 --rounds=1 --connections=16 --scenarios=plaintext,json --frameworks=openmesh,fastify --output=results/smoke.json",
    "bench:guard": "node benchmarks/guard.cjs",
    "build": "node scripts/build.cjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run test:types && npm run test:package && npm run demo:services",
    "bench:mesh": "node benchmarks/mesh/run.cjs"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@peculiar/x509": "^2.1.0",
    "@types/node": "^24.0.0",
    "autocannon": "8.0.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "fastify": "5.12.5",
    "helmet": "8.3.0",
    "koa": "3.2.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "7.0.2"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "service-mesh",
    "mtls",
    "spiffe",
    "workload-identity",
    "microservices",
    "service-discovery",
    "traffic-management",
    "load-balancing",
    "backpressure",
    "circuit-breaker",
    "distributed-systems",
    "opentelemetry",
    "streaming",
    "redis",
    "http",
    "framework",
    "database",
    "orm"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "overrides": {
    "hyperid": {
      "uuid": "11.1.1"
    }
  }
}
